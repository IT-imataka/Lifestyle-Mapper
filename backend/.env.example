# Lifestyle Mapper バックエンドの環境変数
#
# 項目の正は internal/config/config.go。ここはその写しなので、
# 変数を足すときは必ず config.go 側から先に足すこと。
# 空文字は「未設定」として扱われる。欠けている必須項目は起動時にまとめて報告される。

# ── アプリ ──────────────────────────────────────────
APP_ENV=local                       # local | staging | production
APP_BASE_URL=http://localhost:3000  # shareUrl / OGP の組み立てに使う。本番は https 必須
LOG_LEVEL=info
APP_VERSION=dev                     # コミット SHA。/health が返す

# ── サーバ ──────────────────────────────────────────
PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=15s
CORS_ORIGINS=http://localhost:3000  # カンマ区切り。本番で * は不可
RATE_LIMIT_PER_MINUTE=30            # 1 IP あたり。LLM 課金を守る最後の砦

# ── データベース ────────────────────────────────────
DATABASE_URL=postgres://app:password@localhost:5432/lifestyle_mapper?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# ── キャッシュ（Places / Routes のコスト削減に必須） ──
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379    # CACHE_ENABLED=true なら必須
CACHE_PLACES_TTL=6h
CACHE_ROUTES_TTL=1h

# ── 楽天ウェブサービス ──────────────────────────────
RAKUTEN_APPLICATION_ID=             # 必須
RAKUTEN_AFFILIATE_ID=               # 本番では必須。未設定だと収益がゼロになる
RAKUTEN_TIMEOUT=5s
RAKUTEN_QPS=1                       # 概ね 1req/sec 制限。ここだけは直列化される

# ── Google Maps Platform（Places / Routes 共通キー） ──
GOOGLE_MAPS_API_KEY=                # 必須
GOOGLE_PLACES_TIMEOUT=5s
GOOGLE_ROUTES_TIMEOUT=5s
PHOTO_PROXY_BASE_URL=               # 本番では必須。写真の直リンクはキー露出になる

# ── LLM ─────────────────────────────────────────────
LLM_ENABLED=true                    # false ならルールベースで時系列だけ組む
LLM_TIMEOUT=30s
LLM_MAX_REPAIR_ATTEMPTS=1           # Validator 不合格時の再生成回数
LLM_SCHEMA_VERSION=plan_output.v1
LLM_PROMPT_VERSION=plan_v1

ANTHROPIC_API_KEY=                  # LLM_ENABLED=true なら Gemini とどちらか必須
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_EFFORT=medium

GEMINI_API_KEY=                     # フォールバック先
GEMINI_MODEL=                       # GEMINI_API_KEY を入れるなら型番も必須

# ── プラン生成 ──────────────────────────────────────
PLAN_TTL=15m                        # 空室情報の鮮度保証
PLAN_COLLECT_TIMEOUT=12s            # 外部 3 API の収集全体の上限。超過分は部分失敗扱い
PLAN_MAX_CANDIDATES=8               # LLM 入力トークン量＝コストのノブ（3〜20）
